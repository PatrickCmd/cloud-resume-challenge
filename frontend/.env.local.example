# Local Development Configuration (Copy to .env.local)
# Use this to override environment settings for local development

# Toggle to use mock API for offline development
VITE_USE_MOCK_API=true

# Or use local backend server
# VITE_API_BASE_URL=http://localhost:8000
# VITE_USE_MOCK_API=false

# Debug
VITE_DEBUG_API_CALLS=true
