# Application Configuration
ENVIRONMENT=development
APP_NAME=Portfolio API

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=patrickcmd

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
OWNER_EMAIL=your-email@example.com

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=portfolio-api-table
# For local DynamoDB (leave empty for AWS)
DYNAMODB_ENDPOINT=http://localhost:8000

# E2E Test Configuration
# Development environment
DEV_API_URL=https://api-dev.patrickcmd.dev
DEV_DYNAMODB_TABLE_NAME=development-portfolio-api-table
DEV_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
DEV_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
DEV_TEST_USER_EMAIL=test-user@example.com
DEV_TEST_USER_PASSWORD=TestPassword123!

# Production environment
PROD_API_URL=https://api.patrickcmd.dev
PROD_DYNAMODB_TABLE_NAME=production-portfolio-api-table
PROD_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
PROD_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
PROD_TEST_USER_EMAIL=test-user@example.com
PROD_TEST_USER_PASSWORD=TestPassword123!

# CORS Configuration (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://patrickcmd.com
